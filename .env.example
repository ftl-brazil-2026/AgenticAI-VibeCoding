# Copy to .env for local exercises. Never put real credentials in this file.
OPENROUTER_API_KEY=

# Course prompt-injection lab profile. The launcher/middleware must enforce these.
LAB_OFFLINE=1
LAB_ALLOW_NETWORK=0
LAB_ALLOWED_TOOLS=read_fixture,validate_schema

# Disable common telemetry and remote model downloads where supported.
DO_NOT_TRACK=1
OTEL_SDK_DISABLED=true
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
